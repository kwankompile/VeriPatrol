# Laravel generated cache and runtime data. Keep writable directory placeholders.
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitkeep

/backend/storage/app/*
!/backend/storage/app/.gitkeep
!/backend/storage/app/private/
!/backend/storage/app/public/
/backend/storage/app/private/*
!/backend/storage/app/private/.gitkeep
/backend/storage/app/public/*
!/backend/storage/app/public/.gitkeep

/backend/storage/framework/compiled.php
/backend/storage/framework/config.php
/backend/storage/framework/down
/backend/storage/framework/events.scanned.php
/backend/storage/framework/maintenance.php
