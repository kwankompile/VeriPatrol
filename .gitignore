/backend/storage/framework/routes.scanned.php
/backend/storage/framework/schedule-*
/backend/storage/framework/services.json
/backend/storage/framework/cache/*
!/backend/storage/framework/cache/.gitkeep
!/backend/storage/framework/cache/data/
