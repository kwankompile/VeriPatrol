# ANPR / Python / Machine Learning
/anpr/**/__pycache__/
/anpr/**/*.py[cod]
/anpr/**/*$py.class
/anpr/.venv/
/anpr/venv/
/anpr/env/
/anpr/ENV/
/anpr/.pytest_cache/
/anpr/.mypy_cache/
/anpr/.ruff_cache/
/anpr/.hypothesis/
/anpr/.tox/
/anpr/.nox/
/anpr/.coverage
/anpr/.coverage.*
/anpr/htmlcov/
/anpr/coverage.xml

# Model weights are supplied separately; model directory placeholders stay tracked.
/anpr/**/*.pt
/anpr/**/*.pth
/anpr/**/*.onnx
/anpr/**/*.weights
/anpr/**/*.engine
/anpr/**/*.safetensors
/anpr/**/*.tflite

# Runtime output may contain tokens, plate data, images, and backend payloads.
/anpr/runs/*
!/anpr/runs/.gitkeep
/anpr/.cache/*
!/anpr/.cache/.gitkeep

# Keep only the documented sample fixtures currently required by examples.
/anpr/samples/videos/*
!/anpr/samples/videos/.gitkeep
!/anpr/samples/videos/document_6177158287369184218.mp4
/anpr/samples/images/*
!/anpr/samples/images/.gitkeep
!/anpr/samples/images/photo_6177158287829176211_w.jpg
!/anpr/samples/images/photo_6177158287829176212_w.jpg
!/anpr/samples/images/photo_6235330583311617544_y.jpg

