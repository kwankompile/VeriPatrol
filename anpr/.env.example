# AI ANPR — example environment configuration
# Copy to .env and adjust values.

# --- Source ---
ANPR_SOURCE=rtsp
ANPR_RTSP_URL=rtsp://user:password@camera-ip:554/stream1
ANPR_VIDEO_PATH=samples/videos/document_6177158287369184218.mp4
ANPR_IMAGE_PATH=samples/images/photo_6177158287829176211_w.jpg
ANPR_CAMERA_INDEX=0

# --- Models ---
# Model files are NOT committed or auto-downloaded. Place .pt files manually.
ANPR_VEHICLE_MODEL=models/vehicle/yolo11s.pt
ANPR_PLATE_MODEL=models/plate/license-plate-finetune-v1s.pt
ANPR_DEVICE=cpu
ANPR_VEHICLE_CONF=0.35
# Lower values (0.20–0.25) help motorcycle plate detection; tune per camera/scene.
ANPR_PLATE_CONF=0.25
# Vehicle crop padding for plate detection (motorcycles use a larger default crop).
ANPR_VEHICLE_CROP_PADDING_RATIO=0.20
ANPR_MOTORCYCLE_CROP_PADDING_RATIO=0.35
# Max center-distance for fallback plate-to-vehicle association (ratio of expanded bbox diagonal).
ANPR_PLATE_FALLBACK_MAX_DISTANCE_RATIO=0.60

# --- Debug ---
# Save annotated detection frames (vehicle + plate boxes) under runs/<run_id>/debug/
ANPR_DEBUG_DETECTIONS=false

# --- OCR (M4+) ---
ANPR_OCR_ENGINE=paddleocr
ANPR_OCR_LANG=en
ANPR_OCR_PREPROCESS=true
ANPR_OCR_SCALE=2.0
ANPR_MIN_OCR_CONFIDENCE=0.30
ANPR_OCR_MIN_INTERVAL_SECONDS=0.35

# --- Tracking / vote buffer (M5) ---
ANPR_TARGET_FPS=3
ANPR_TRACK_IOU_THRESHOLD=0.3
ANPR_TRACK_EXPIRY_SECONDS=2.0
ANPR_EARLY_FINALIZE_MIN_VOTES=3
ANPR_EARLY_FINALIZE_MIN_CONFIDENCE=0.90
ANPR_MIN_PLATE_VOTES=2

# --- Events / evidence (M6) ---
ANPR_DUPLICATE_COOLDOWN_SECONDS=10

# --- Backend (M7/M8/M9/M3) ---
ANPR_BACKEND_ENABLED=false
ANPR_BACKEND_BASE_URL=http://localhost:8000/api
ANPR_CAMERA_EMAIL=
ANPR_CAMERA_PASSWORD=
ANPR_BACKEND_TOKEN_CACHE=.cache/backend_token.json
ANPR_BACKEND_QUEUE_FILE=.cache/backend_queue.jsonl
ANPR_BACKEND_RETRY_LIMIT=3
ANPR_BACKEND_TIMEOUT_SECONDS=10

# --- Evidence delivery (M9/M10) ---
# upload = recommended for backend/cloud deployment AND the runtime default when ANPR_EVIDENCE_MODE is omitted.
#         AI uploads evidence files to Laravel storage/app/anpr.
# metadata = local development only; sends file paths and requires Laravel ANPR_IMAGE_ROOTS to read the AI runs directory.
ANPR_EVIDENCE_MODE=upload
ANPR_EVIDENCE_RETENTION_DAYS=0
ANPR_RUNS_DIR=runs
ANPR_SAVE_LOCAL_EVIDENCE=true
ANPR_DELETE_LOCAL_AFTER_UPLOAD=false

# --- M11 realtime RTSP runtime ---
ANPR_RTSP_RECONNECT_ENABLED=true
ANPR_RTSP_RECONNECT_MAX_ATTEMPTS=0
ANPR_RTSP_RECONNECT_INITIAL_DELAY_SECONDS=2.0
ANPR_RTSP_RECONNECT_MAX_DELAY_SECONDS=30.0
ANPR_RTSP_READ_FAILURE_LIMIT=10
ANPR_RTSP_HEALTH_LOG_INTERVAL_SECONDS=15.0
ANPR_BACKEND_QUEUE_FLUSH_INTERVAL_SECONDS=10.0
