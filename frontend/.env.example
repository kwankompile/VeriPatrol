# Copy to .env.local or set at build time. Only VITE_* vars are exposed to the browser bundle.

VITE_APP_VERSION=v5.1.0
VITE_APP_BASE_NAME=/
VITE_API_BASE_URL=http://localhost:8000/api

# Web Push — public key only (must match backend VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=

# Laravel Reverb / Echo (patrol monitoring realtime). Set VITE_REVERB_ENABLED=false to disable.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Optional dev diagnostics (not required in production)
# VITE_PWA_DEBUG=true
# VITE_APP_DEBUG=true
# VITE_REVERB_ENABLED=false
